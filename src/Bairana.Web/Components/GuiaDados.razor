@using System.Text.Json
@inject EmpreendedorDataService Dados

@if (carregando)
{
    <section class="loading-state" role="status" aria-busy="true">
        <h1 class="visually-hidden">Carregando o guia…</h1>
        <div class="loading-message"><span class="loading-spinner" aria-hidden="true"></span>Buscando os negócios dos seus vizinhos…</div>
        <div class="skeleton-content" aria-hidden="true">
            <div class="skeleton-categories"><span></span><span></span><span></span><span></span></div>
            <div class="skeleton-grid">
                @for (var i = 0; i < 2; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-card-heading"><span class="skeleton-thumb"></span><div><span class="skeleton-line"></span><span class="skeleton-line short"></span><div class="skeleton-tags"><span></span><span></span></div></div></div>
                        <span class="skeleton-line"></span><span class="skeleton-line medium"></span>
                        <div class="skeleton-footer"><span class="skeleton-line short"></span><span class="skeleton-button"></span></div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else if (erro)
{
    <section class="state-panel error-state" role="alert">
        <div class="state-illustration"><Icone Nome="wifi-off" /></div>
        <h1>Não foi possível carregar o guia.</h1>
        <p>Não conseguimos buscar os negócios. Verifique sua conexão e tente novamente em instantes.</p>
        <button class="button button-primary" @onclick="CarregarAsync"><Icone Nome="refresh" />Tentar novamente</button>
    </section>
}
else
{
    @ChildContent(registros)
}

@code {
    [Parameter, EditorRequired] public RenderFragment<IReadOnlyList<Empreendedor>> ChildContent { get; set; } = default!;
    private IReadOnlyList<Empreendedor> registros = [];
    private bool carregando = true;
    private bool erro;

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        carregando = true;
        erro = false;
        try
        {
            registros = await Dados.CarregarAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidDataException or OperationCanceledException)
        {
            erro = true;
        }
        finally
        {
            carregando = false;
        }
    }
}
