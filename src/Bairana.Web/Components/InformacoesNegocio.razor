@if (!string.IsNullOrWhiteSpace(Negocio.Horario) || Negocio.Entrega == true || Negocio.PrecoInicial.HasValue)
{
    <ul class="business-info" aria-label="Informações do negócio">
        @if (!string.IsNullOrWhiteSpace(Negocio.Horario))
        {
            <li><span aria-hidden="true">◷</span><span><span class="visually-hidden">Horário declarado: </span>@Negocio.Horario</span></li>
        }
        @if (Negocio.Entrega == true)
        {
            <li><span aria-hidden="true">⌂</span><span>Entrega no condomínio</span></li>
        }
        @if (Negocio.PrecoInicial is decimal preco)
        {
            <li class="starting-price">A partir de @preco.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public Empreendedor Negocio { get; set; } = default!;
}
