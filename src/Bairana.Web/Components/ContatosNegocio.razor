@if (ExibirWhatsapp)
{
    @if (LinksExternos.Whatsapp(Negocio.Whatsapp) is string whatsapp)
    {
        <a class="button button-whatsapp" href="@whatsapp" target="_blank" rel="noopener noreferrer">
            <Icone Nome="whatsapp" />Falar no WhatsApp<span class="visually-hidden"> (abre em nova aba)</span>
        </a>
    }
    else if (MostrarDemonstracao)
    {
        <button class="button button-whatsapp" disabled><Icone Nome="whatsapp" />WhatsApp indisponível na demo</button>
    }
}
@if (ExibirInstagram && LinksExternos.Instagram(Negocio.Instagram) is string instagram)
{
    <a class="instagram-link" href="@instagram" target="_blank" rel="noopener noreferrer">
        <span class="info-icon"><Icone Nome="instagram" /></span><span><span class="info-label">Instagram do negócio</span>@@@Negocio.Instagram</span>
        <Icone Nome="external" /><span class="visually-hidden"> (abre em nova aba)</span>
    </a>
}

@code {
    [Parameter, EditorRequired] public Empreendedor Negocio { get; set; } = default!;
    [Parameter] public bool ExibirWhatsapp { get; set; } = true;
    [Parameter] public bool ExibirInstagram { get; set; } = true;
    [Parameter] public bool MostrarDemonstracao { get; set; }
}
